{
  "name": "senastr",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first AI coding agent desktop workspace",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "pnpm build:packages && pnpm bundle:host && pnpm --filter @senastr/desktop build",
    "build:packages": "pnpm -r --filter \"./packages/*\" build",
    "dev": "pnpm build:packages && pnpm --filter @senastr/desktop dev",
    "demo": "node scripts/demo.mjs",
    "postinstall": "node scripts/postinstall.mjs",
    "typecheck": "pnpm build:packages && pnpm -r --filter \"./packages/*\" typecheck && pnpm --filter @senastr/desktop typecheck",
    "test": "pnpm build:packages && vitest run",
    "test:ui": "vitest run --project desktop-ui",
    "test:watch": "vitest",
    "clean": "pnpm -r --if-present clean",
    "bundle:host": "node scripts/bundle-host.mjs",
    "test:e2e": "node scripts/e2e-electron-boot.mjs",
    "verify:packaging": "node scripts/verify-packaging.mjs"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.10.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.0",
    "esbuild": "^0.25.0"
  }
}
